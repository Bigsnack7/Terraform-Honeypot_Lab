aws_region                = "us-east-1"
environment               = "dev"
honeypot_ingress_cidrs     = []
enable_linux_honeypot      = false
enable_web_honeypot        = false
enable_windows_honeypot    = false
enable_smb_listener        = false
enable_guardduty           = false
enable_security_hub        = false
enable_aws_config          = false
enable_budget              = true
budget_alert_email         = ""
alert_email                = ""
log_retention_days         = 7
audit_log_retention_days   = 90
linux_instance_type        = "t3.micro"
web_instance_type          = "t3.micro"
windows_instance_type       = "t3.small"
cloudwatch_agent_version    = "1.300074.1b2005"
cloudwatch_agent_msi_sha256 = "3891c26f477cc47cf1b3965b18ffb25532b67e4534b60f692cb6605b6bee1577"
enable_ssm_management      = true
