"Get-Content 'C:/ProgramData/Amazon/AmazonCloudWatchAgent/amazon-cloudwatch-agent.json' -ErrorAction SilentlyContinue",
"Get-WinEvent -FilterHashtable @{LogName='Application';ProviderName='AmazonCloudWatchAgent'} -MaxEvents 5 -ErrorAction SilentlyContinue | Format-List TimeCreated,Message | Out-String -Width 200",
"Get-WinEvent -FilterHashtable @{LogName='System';ProviderName='Service Control Manager'} -MaxEvents 5 -ErrorAction SilentlyContinue | Format-List TimeCreated,Message | Out-String -Width 200"
]}
