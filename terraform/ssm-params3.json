{"commands":[
"Get-Content 'C:/ProgramData/Amazon/AmazonCloudWatchAgent/amazon-cloudwatch-agent.log' -ErrorAction SilentlyContinue",
"Get-Content 'C:/ProgramData/Amazon/AmazonCloudWatchAgent/Logs/configuration-validation.log' -ErrorAction SilentlyContinue",
"sc.exe qc AmazonCloudWatchAgent",
"Get-ChildItem 'C:/Program Files/Amazon/AmazonCloudWatchAgent' | Select-Object Name,Length | Format-Table -AutoSize | Out-String -Width 200",
"Get-WinEvent -FilterHashtable @{LogName='System';Id=7000,7001,7009,7011,7023,7024,7031,7034} -MaxEvents 10 -ErrorAction SilentlyContinue | Format-List TimeCreated,Id,Message | Out-String -Width 200",
"Start-Service AmazonCloudWatchAgent 2>&1 | Out-String",
"Start-Sleep -Seconds 5; Get-Service AmazonCloudWatchAgent | Format-List Name,Status | Out-String",
"Get-Content 'C:/ProgramData/Amazon/AmazonCloudWatchAgent/Configs/file_amazon-cloudwatch-agent.json' -ErrorAction SilentlyContinue"
]}
